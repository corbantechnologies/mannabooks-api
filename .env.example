# Copy to .env for local development. On Railway, set these as service variables.

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL (required). Railway provides DATABASE_URL; locally use the Railway database's public URL.
DATABASE_URL=postgresql://user:password@host:5432/railway
# Optional: a different server for tests. Tests create and drop a `test_<name>` database there.
# TEST_DATABASE_URL=

# Redis for Celery (Railway Redis provides REDIS_URL)
REDIS_URL=redis://localhost:6379/0
# Run background jobs inline while developing without Redis
CELERY_TASK_ALWAYS_EAGER=True

# Google sign-in: off for now. To turn it on, set True and the OAuth client id(s) the web app uses.
GOOGLE_SIGNIN_ENABLED=False
GOOGLE_CLIENT_IDS=

# KRA eTIMS signing for the whole platform: keep False until KRA approves MannaBooks.
ETIMS_ENABLED=False
# ETIMS_SANDBOX_URL=https://etims-api-sbx.kra.go.ke/etims-api
# ETIMS_PRODUCTION_URL=https://etims-api.kra.go.ke/etims-api
# Fernet key for secrets stored in the database. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# JWT lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14

# Email (console backend prints emails to the terminal while developing)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=MannaBooks <no-reply@mannabooks.co.ke>

# Public address of this API, for Safaricom M-Pesa callbacks (e.g. https://api.mannabooks.co.ke)
PUBLIC_API_URL=http://localhost:8000
